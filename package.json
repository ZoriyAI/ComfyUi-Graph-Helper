{
  "name": "comfyui-graph-builder",
  "productName": "Graph Helper for ComfyUI",
  "version": "0.6.0",
  "description": "Collaborative visual ComfyUI workflow builder with LLM assistance",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "npm run rebuild:native && npm run build:main && node scripts/assert-current-main.js && NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "watch": "tsc --watch",
    "start": "npm run rebuild:native && npm run build && node scripts/assert-current-main.js && electron .",
    "test": "vitest run",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package:linux": "npm run rebuild:native && npm run build && node scripts/assert-current-main.js && electron-forge make --platform linux && node scripts/smoke-linux-package.js",
    "type-check": "tsc --project tsconfig.main.json --noEmit && tsc --noEmit",
    "lint": "eslint src/",
    "shots": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node scripts/capture-screens/capture.js"
  },
  "keywords": [
    "comfyui",
    "workflow",
    "graph",
    "llm",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/openai": "^4.0.110",
    "@fontsource/geist": "5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.164",
    "better-sqlite3": "13.0.3",
    "i18next": "27.0.1",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "18.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
