{
  "name": "nodewise-studio",
  "productName": "NodeWise Studio",
  "desktopName": "nodewise-studio.desktop",
  "version": "1.4.0",
  "description": "Create, learn and get guidance in ComfyUI",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "npm run build:main && node scripts/assert-current-main.js && NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:main && npm run build:renderer && node scripts/build-assets.js",
    "watch": "tsc --watch",
    "start": "npm run build && node scripts/assert-current-main.js && electron .",
    "test": "vitest run",
    "package:linux": "npm run build && node scripts/assert-current-main.js && npm run make:linux && npm run smoke:linux",
    "make:linux": "electron-forge make --platform linux --arch x64 && node scripts/make-linux-portable.js",
    "smoke:linux": "node scripts/smoke-linux-package.js && node scripts/smoke-linux-portable.js",
    "test:perf": "PERF_BUDGETS=1 vitest run tests/unit/largeCatalog.test.ts",
    "type-check": "tsc --project tsconfig.main.json --noEmit && tsc --noEmit && tsc --project tsconfig.tests.json",
    "type-check:tests": "tsc --project tsconfig.tests.json",
    "lint": "eslint src tests scripts forge.config.js",
    "shots": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node scripts/capture-screens/capture.js",
    "shots:public": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node scripts/capture-screens/public.js"
  },
  "keywords": [
    "comfyui",
    "comfyui-workflow",
    "stable-diffusion",
    "generative-ai",
    "learning",
    "tutorial",
    "education",
    "node-graph",
    "desktop-app",
    "electron",
    "linux",
    "ai-assistant"
  ],
  "author": "ZoriyAI",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/ZoriyAI/nodewise-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoriyAI/nodewise-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ZoriyAI/nodewise-studio/issues"
  },
  "private": true,
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "9.39.1",
    "@fontsource/geist": "5.3.0",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@xyflow/react": "^12.12.1",
    "concurrently": "^10.0.7",
    "electron": "^45.3.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "playwright": "^1.65.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "18.0.0",
    "semver": "7.8.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.6",
    "vite-node": "6.0.0",
    "vitest": "5.1.0",
    "yaml": "2.8.4",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/google": "4.0.122",
    "@ai-sdk/openai": "^4.0.121",
    "@ai-sdk/provider": "4.0.39",
    "@ai-sdk/provider-utils": "5.0.82",
    "@dagrejs/graphlib": "4.0.7",
    "@fontsource/geist-mono": "5.2.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "ai": "^7.0.176",
    "better-sqlite3": "13.0.3",
    "i18next": "27.0.1",
    "zod": "^4.6.7"
  }
}
